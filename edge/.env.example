# Edge node settings. Copy to edge/.env (never committed) and fill in.
# No spaces inside values.

# Model to serve: INT4 Qwen/Qwen2.5-7B-Instruct-AWQ, INT8 Qwen/Qwen2.5-7B-Instruct-GPTQ-Int8
MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
PORT=8000

# Optional on a private LAN. If set, client/.env needs the same value as LLM_API_KEY.
API_KEY=

# Shelly Plug S Gen3 (wall-level power), its local IP. Empty = GPU energy only.
PLUG_IP=

# Lock the GPU core clock during serve, in MHz (needs sudo). Empty = not locked.
LOCK_CLOCK_MHZ=
