# Client settings. Copy to client/.env (never committed) and fill in. One file per campaign
# (edge or cloud). The values used are saved with every run in results/<run>/clientInfo.txt
# (without the API key).

# Serving node
SERVER_URL=http://<server-ip>:8000     # edge: its LAN IP; cloud: its public IP
SERVER_TYPE=edge                       # edge | cloud
LLM_API_KEY=                           # same value as API_KEY in the server's .env (empty if none)
# SERVER_SSH=root@<cloud-ip>           # cloud only: lets client/campaign.sh switch the server's model

# What runs on the server (must match MODEL in the server's .env)
MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ     # INT8 campaign: Qwen/Qwen2.5-7B-Instruct-GPTQ-Int8
QUANTIZATION=INT4                      # INT4 | INT8
GPU_MODEL=RTX 5080 Laptop GPU          # cloud: NVIDIA L40S
ENGINE_VERSION=0.33.0                  # vLLM version on the server (common/requirements-server.txt)
NETWORK_PROFILE=none                   # tc/netem profile name, if one is applied

# Grid (covers what the simulator samples: inputs up to 4096, outputs up to 768)
INPUTS=128,512,1024,2048,4096
OUTPUTS=64,128,256,512,768
CONCURRENCY=1,5,10,20,40
REPS=3                                 # computeModel.py needs >= 3 valid reps per point
REQUESTS=50
IGNORE_EOS=1                           # 1 = fixed output length (sweeps); 0 = natural termination runs
