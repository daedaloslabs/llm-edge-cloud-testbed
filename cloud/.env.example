# Cloud node settings. Copy to cloud/.env (never committed) and fill in.
# No spaces inside values.

# Model to serve: INT4 Qwen/Qwen2.5-7B-Instruct-AWQ, INT8 Qwen/Qwen2.5-7B-Instruct-GPTQ-Int8
MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
PORT=8000

# Required on a public IP. Leave empty: setup generates one. Copy it to client/.env.
API_KEY=

# Lock the GPU core clock during serve, in MHz. Empty = not locked.
LOCK_CLOCK_MHZ=
